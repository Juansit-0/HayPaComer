{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "HayPaComer Copper Counter",
  "version": "1.0.0",
  "primitive": {
    "color": {
      "$type": "color",
      "copper-500": { "$value": "#c2711c" },
      "copper-600": { "$value": "#b45309" },
      "copper-700": { "$value": "#9a3412" },
      "copper-800": { "$value": "#7c2d12" },
      "paprika-600": { "$value": "#c2410c" },
      "olive-600": { "$value": "#4d7c0f" },
      "olive-700": { "$value": "#3f6212" },
      "amber-500": { "$value": "#f59e0b" },
      "orange-600": { "$value": "#ea580c" },
      "lime-500": { "$value": "#84cc16" },
      "ink-950": { "$value": "#1c1917" },
      "ink-900": { "$value": "#292524" },
      "ink-600": { "$value": "#57534e" },
      "ink-500": { "$value": "#78716c" },
      "ink-400": { "$value": "#a8a29e" },
      "sand-50": { "$value": "#faf4ea" },
      "sand-100": { "$value": "#f5edde" },
      "sand-200": { "$value": "#eadfc8" },
      "sand-300": { "$value": "#d6ccbb" },
      "white": { "$value": "#ffffff" }
    },
    "fontFamily": {
      "$type": "fontFamily",
      "display": { "$value": ["Bricolage Grotesque", "ui-sans-serif", "system-ui", "sans-serif"] },
      "sans": { "$value": ["Hanken Grotesk", "ui-sans-serif", "system-ui", "sans-serif"] },
      "mono": { "$value": ["IBM Plex Mono", "ui-monospace", "SFMono-Regular", "monospace"] }
    },
    "fontSize": {
      "$type": "dimension",
      "h1": { "$value": "40px" },
      "h2": { "$value": "32px" },
      "h3": { "$value": "24px" },
      "h4": { "$value": "20px" },
      "body": { "$value": "16px" },
      "small": { "$value": "14px" },
      "data": { "$value": "16px" }
    },
    "lineHeight": {
      "$type": "number",
      "h1": { "$value": 1.2 },
      "h2": { "$value": 1.25 },
      "h3": { "$value": 1.33 },
      "h4": { "$value": 1.4 },
      "body": { "$value": 1.5 },
      "small": { "$value": 1.43 },
      "data": { "$value": 1.5 }
    },
    "space": {
      "$type": "dimension",
      "0": { "$value": "0px" },
      "xs": { "$value": "8px" },
      "s": { "$value": "16px" },
      "m": { "$value": "24px" },
      "l": { "$value": "32px" },
      "xl": { "$value": "48px" },
      "xxl": { "$value": "80px" }
    },
    "radius": {
      "$type": "dimension",
      "6": { "$value": "6px" },
      "10": { "$value": "10px" },
      "14": { "$value": "14px" },
      "full": { "$value": "999px" }
    },
    "shadow": {
      "$type": "shadow",
      "subtle": {
        "$value": {
          "color": "#29252414",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
      },
      "raised": {
        "$value": {
          "color": "#2925241f",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "12px",
          "spread": "0px"
        }
      }
    },
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "320ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "bg": { "$value": "{primitive.color.sand-50}" },
      "surface": { "$value": "{primitive.color.sand-100}" },
      "text": { "$value": "{primitive.color.ink-900}" },
      "text-weak": { "$value": "{primitive.color.ink-600}" },
      "border": { "$value": "{primitive.color.sand-200}" },
      "border-strong": { "$value": "{primitive.color.ink-500}" },
      "primary": { "$value": "{primitive.color.copper-600}" },
      "primary-fg": { "$value": "{primitive.color.white}" },
      "primary-hover": { "$value": "{primitive.color.copper-700}" },
      "primary-active": { "$value": "{primitive.color.copper-800}" },
      "attention": { "$value": "{primitive.color.paprika-600}" },
      "attention-fg": { "$value": "{primitive.color.white}" },
      "positive": { "$value": "{primitive.color.olive-600}" },
      "positive-fg": { "$value": "{primitive.color.white}" },
      "focus": { "$value": "{primitive.color.copper-600}" },
      "dark": {
        "$type": "color",
        "bg": { "$value": "{primitive.color.ink-950}" },
        "surface": { "$value": "{primitive.color.ink-900}" },
        "text": { "$value": "{primitive.color.sand-50}" },
        "text-weak": { "$value": "{primitive.color.sand-300}" },
        "border": { "$value": "{primitive.color.ink-600}" },
        "border-strong": { "$value": "{primitive.color.ink-400}" },
        "primary": { "$value": "{primitive.color.amber-500}" },
        "primary-fg": { "$value": "{primitive.color.ink-950}" },
        "attention": { "$value": "{primitive.color.orange-600}" },
        "attention-fg": { "$value": "{primitive.color.ink-950}" },
        "positive": { "$value": "{primitive.color.lime-500}" },
        "positive-fg": { "$value": "{primitive.color.ink-950}" },
        "focus": { "$value": "{primitive.color.amber-500}" }
      }
    },
    "typography": {
      "font-display": { "$type": "fontFamily", "$value": "{primitive.fontFamily.display}" },
      "font-body": { "$type": "fontFamily", "$value": "{primitive.fontFamily.sans}" },
      "font-data": { "$type": "fontFamily", "$value": "{primitive.fontFamily.mono}" },
      "size-h1": { "$type": "dimension", "$value": "{primitive.fontSize.h1}" },
      "size-h2": { "$type": "dimension", "$value": "{primitive.fontSize.h2}" },
      "size-h3": { "$type": "dimension", "$value": "{primitive.fontSize.h3}" },
      "size-h4": { "$type": "dimension", "$value": "{primitive.fontSize.h4}" },
      "size-body": { "$type": "dimension", "$value": "{primitive.fontSize.body}" },
      "size-small": { "$type": "dimension", "$value": "{primitive.fontSize.small}" },
      "size-data": { "$type": "dimension", "$value": "{primitive.fontSize.data}" }
    },
    "space": {
      "gap-xs": { "$type": "dimension", "$value": "{primitive.space.xs}" },
      "gap-s": { "$type": "dimension", "$value": "{primitive.space.s}" },
      "gap-m": { "$type": "dimension", "$value": "{primitive.space.m}" },
      "gap-l": { "$type": "dimension", "$value": "{primitive.space.l}" },
      "gap-xl": { "$type": "dimension", "$value": "{primitive.space.xl}" },
      "gap-xxl": { "$type": "dimension", "$value": "{primitive.space.xxl}" }
    },
    "radius": {
      "control": { "$type": "dimension", "$value": "{primitive.radius.10}" },
      "card": { "$type": "dimension", "$value": "{primitive.radius.14}" },
      "chip": { "$type": "dimension", "$value": "{primitive.radius.full}" }
    },
    "elevation": {
      "card": { "$type": "shadow", "$value": "{primitive.shadow.subtle}" },
      "overlay": { "$type": "shadow", "$value": "{primitive.shadow.raised}" }
    },
    "motion": {
      "duration-fast": { "$type": "duration", "$value": "{primitive.duration.fast}" },
      "duration-base": { "$type": "duration", "$value": "{primitive.duration.base}" },
      "ease-standard": { "$type": "cubicBezier", "$value": "{primitive.easing.standard}" }
    }
  },
  "component": {
    "button-primary": {
      "bg": { "$type": "color", "$value": "{semantic.color.primary}" },
      "fg": { "$type": "color", "$value": "{semantic.color.primary-fg}" },
      "bg-hover": { "$type": "color", "$value": "{semantic.color.primary-hover}" },
      "bg-active": { "$type": "color", "$value": "{semantic.color.primary-active}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.control}" }
    },
    "button-secondary": {
      "bg": { "$type": "color", "$value": "#00000000" },
      "fg": { "$type": "color", "$value": "{semantic.color.text}" },
      "border": { "$type": "color", "$value": "{semantic.color.border-strong}" },
      "bg-hover": { "$type": "color", "$value": "{semantic.color.surface}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.control}" }
    },
    "button-ghost": {
      "fg": { "$type": "color", "$value": "{semantic.color.primary}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.control}" }
    },
    "input": {
      "bg": { "$type": "color", "$value": "{semantic.color.surface}" },
      "fg": { "$type": "color", "$value": "{semantic.color.text}" },
      "placeholder": { "$type": "color", "$value": "{semantic.color.text-weak}" },
      "border": { "$type": "color", "$value": "{semantic.color.border-strong}" },
      "focus-ring": { "$type": "color", "$value": "{semantic.color.focus}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.control}" }
    },
    "card": {
      "bg": { "$type": "color", "$value": "{semantic.color.surface}" },
      "border": { "$type": "color", "$value": "{semantic.color.border}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.card}" },
      "padding": { "$type": "dimension", "$value": "{primitive.space.m}" }
    },
    "badge": {
      "bg": { "$type": "color", "$value": "{semantic.color.surface}" },
      "fg": { "$type": "color", "$value": "{semantic.color.text-weak}" },
      "border": { "$type": "color", "$value": "{semantic.color.border-strong}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.chip}" }
    },
    "data-display": {
      "font": { "$type": "fontFamily", "$value": "{semantic.typography.font-data}" },
      "size": { "$type": "dimension", "$value": "{semantic.typography.size-data}" },
      "fg": { "$type": "color", "$value": "{semantic.color.text}" }
    },
    "status": {
      "attention": { "$type": "color", "$value": "{semantic.color.attention}" },
      "positive": { "$type": "color", "$value": "{semantic.color.positive}" }
    }
  }
}
